{
  "name": "cb-parallax",
  "version": "0.9.7",
  "description": "Premium WordPress plugin for custom background images with parallax effects",
  "main": "index.js",
  "scripts": {
    "dev": "webpack --mode development --watch",
    "build": "webpack --mode production",
    "build:css": "sass assets/scss:public/css --style compressed --source-map",
    "build:admin-css": "sass assets/scss/admin:admin/css --style compressed --source-map",
    "watch:css": "sass assets/scss:public/css --watch --style compressed --source-map",
    "lint:js": "eslint assets/js/**/*.js",
    "lint:css": "stylelint assets/scss/**/*.scss",
    "format": "prettier --write \"assets/**/*.{js,scss}\"",
    "test": "jest"
  },
  "keywords": [
    "wordpress",
    "parallax",
    "background",
    "responsive"
  ],
  "author": "demispatti",
  "license": "GPL-2.0-or-later",
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.8.1",
    "eslint": "^8.52.0",
    "jest": "^29.7.0",
    "prettier": "^3.0.3",
    "sass": "^1.69.5",
    "sass-loader": "^13.3.2",
    "style-loader": "^3.3.3",
    "stylelint": "^15.11.0",
    "stylelint-config-standard-scss": "^11.0.0",
    "terser-webpack-plugin": "^5.3.9",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {},
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
